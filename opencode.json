{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepinfra/deepseek-ai/DeepSeek-V4-Flash-0731",
  "mcp": {},
  "permission": {
    "webfetch": "deny",
    "websearch": "deny",
    "skill": "deny",
    "question": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "bash": {
      "*": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git add*": "allow",
      "git checkout -b*": "allow",
      "env*": "deny",
      "printenv*": "deny",
      "curl*": "deny",
      "wget*": "deny",
      "gh *": "deny",
      "rm -rf*": "deny"
    },
    "edit": {
      "*": "allow",
      ".github/**": "deny",
      "opencode.json": "deny",
      ".factory/actions-security.md": "deny",
      "scripts/protect-main.sh": "deny"
    }
  },
  "provider": {
    "deepinfra": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepInfra",
      "options": {
        "baseURL": "https://api.deepinfra.com/v1/openai",
        "apiKey": "{env:DEEPINFRA_API_KEY}"
      },
      "models": {
        "deepseek-ai/DeepSeek-V4-Flash-0731": {
          "name": "DeepSeek V4 Flash"
        },
        "deepseek-ai/DeepSeek-V4-Pro-0813": {
          "name": "DeepSeek V4 Pro"
        },
        "Qwen/Qwen3-Coder-480B-A35B-Instruct-Turbo": {
          "name": "Qwen3 Coder Turbo"
        }
      }
    }
  }
}
