{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Data-Science-Link/software_factory_template/.factory/schemas/run-record.schema.json",
  "title": "Factory agent run record",
  "description": "Vision §8 field set, plus extensions documented in .factory/schemas/README.md: cost_method provider_reported (#30) and optional steps[] with per-step model prices (#41).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "repo",
    "issue",
    "issues",
    "pr",
    "spec_path",
    "spec_link",
    "trigger",
    "triggered_by",
    "trigger_url",
    "workflow_run_url",
    "harness",
    "harness_version",
    "provider",
    "model",
    "escalated_from",
    "complexity",
    "risk",
    "work_type",
    "price_table_version",
    "price_in_per_mtok",
    "price_cached_per_mtok",
    "price_out_per_mtok",
    "requests",
    "tokens_in",
    "tokens_cached",
    "tokens_out",
    "tokens_reasoning",
    "predicted_cost_usd",
    "actual_cost_usd",
    "cost_method",
    "key_spend_delta_usd",
    "cost_check",
    "budget_cap_usd",
    "issue_spend_to_date_usd",
    "started_at",
    "ended_at",
    "duration_s",
    "actions_minutes",
    "runner",
    "base_sha",
    "head_sha",
    "outcome",
    "gate",
    "gate_passed",
    "notes"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": {
      "type": "string",
      "pattern": "^gha-[0-9]+-[0-9]+$"
    },
    "repo": { "type": "string", "minLength": 1 },
    "issue": { "type": "integer", "minimum": 1 },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1 }
    },
    "pr": { "type": ["integer", "null"], "minimum": 1 },
    "spec_path": { "type": "string", "minLength": 1 },
    "spec_link": { "type": "string", "format": "uri" },
    "trigger": { "type": "string", "enum": ["issue_comment", "workflow_dispatch"] },
    "triggered_by": { "type": "string", "minLength": 1 },
    "trigger_url": { "type": "string", "format": "uri" },
    "workflow_run_url": { "type": "string", "format": "uri" },
    "harness": { "type": "string", "minLength": 1 },
    "harness_version": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "escalated_from": { "type": ["string", "null"] },
    "complexity": { "type": "string", "enum": ["simple", "standard", "complex"] },
    "risk": { "type": "string", "enum": ["trivial", "normal", "high"] },
    "work_type": {
      "type": "string",
      "enum": ["code", "docs", "spec", "review", "data"]
    },
    "price_table_version": { "type": "string", "minLength": 1 },
    "price_in_per_mtok": { "type": "number", "minimum": 0 },
    "price_cached_per_mtok": { "type": "number", "minimum": 0 },
    "price_out_per_mtok": { "type": "number", "minimum": 0 },
    "requests": { "type": "integer", "minimum": 0 },
    "tokens_in": { "type": "integer", "minimum": 0 },
    "tokens_cached": { "type": "integer", "minimum": 0 },
    "tokens_out": { "type": "integer", "minimum": 0 },
    "tokens_reasoning": { "type": "integer", "minimum": 0 },
    "predicted_cost_usd": { "type": "number", "minimum": 0 },
    "actual_cost_usd": { "type": "number", "minimum": 0 },
    "cost_method": {
      "type": "string",
      "enum": [
        "provider_reported",
        "usage_x_price_table",
        "key_spend_delta",
        "not_measured"
      ]
    },
    "key_spend_delta_usd": { "type": ["number", "null"], "minimum": 0 },
    "cost_check": {
      "type": "string",
      "enum": ["match", "mismatch", "skipped_concurrent", "skipped_unavailable"]
    },
    "budget_cap_usd": { "type": "number", "minimum": 0 },
    "issue_spend_to_date_usd": { "type": "number", "minimum": 0 },
    "started_at": { "type": "string", "minLength": 1 },
    "ended_at": { "type": "string", "minLength": 1 },
    "duration_s": { "type": "integer", "minimum": 0 },
    "actions_minutes": { "type": "integer", "minimum": 0 },
    "runner": { "type": "string", "minLength": 1 },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "outcome": {
      "type": "string",
      "enum": [
        "pr_opened",
        "pr_updated",
        "no_changes",
        "failed",
        "cap_exceeded",
        "gate_failed",
        "cancelled"
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gitleaks",
        "run_record_valid",
        "cost_recorded",
        "pr_template",
        "pr_check",
        "budget_cap",
        "no_workflow_changes",
        "spec_present"
      ],
      "properties": {
        "gitleaks": { "$ref": "#/$defs/gate_result" },
        "run_record_valid": { "$ref": "#/$defs/gate_result" },
        "cost_recorded": { "$ref": "#/$defs/gate_result" },
        "pr_template": { "$ref": "#/$defs/gate_result" },
        "pr_check": { "$ref": "#/$defs/gate_result" },
        "budget_cap": { "$ref": "#/$defs/gate_result" },
        "no_workflow_changes": { "$ref": "#/$defs/gate_result" },
        "spec_present": { "$ref": "#/$defs/gate_result" }
      }
    },
    "gate_passed": { "type": "boolean" },
    "notes": { "type": "string" },
    "steps": {
      "type": "array",
      "description": "Extension (#41): optional per-step costs (harness vs review). Not in vision §8 table; see schemas/README.md.",
      "items": { "$ref": "#/$defs/run_step" }
    }
  },
  "$defs": {
    "gate_result": { "type": "string", "enum": ["pass", "fail", "skip"] },
    "run_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_kind",
        "model",
        "price_in_per_mtok",
        "price_cached_per_mtok",
        "price_out_per_mtok",
        "requests",
        "tokens_in",
        "tokens_cached",
        "tokens_out",
        "tokens_reasoning",
        "predicted_cost_usd",
        "actual_cost_usd",
        "cost_method"
      ],
      "properties": {
        "step_kind": { "type": "string", "enum": ["harness", "review"] },
        "model": { "type": "string", "minLength": 1 },
        "price_in_per_mtok": { "type": "number", "minimum": 0 },
        "price_cached_per_mtok": { "type": "number", "minimum": 0 },
        "price_out_per_mtok": { "type": "number", "minimum": 0 },
        "requests": { "type": "integer", "minimum": 0 },
        "tokens_in": { "type": "integer", "minimum": 0 },
        "tokens_cached": { "type": "integer", "minimum": 0 },
        "tokens_out": { "type": "integer", "minimum": 0 },
        "tokens_reasoning": { "type": "integer", "minimum": 0 },
        "predicted_cost_usd": { "type": "number", "minimum": 0 },
        "actual_cost_usd": { "type": "number", "minimum": 0 },
        "cost_method": {
          "type": "string",
          "enum": [
            "provider_reported",
            "usage_x_price_table",
            "key_spend_delta",
            "not_measured"
          ]
        }
      }
    }
  }
}
